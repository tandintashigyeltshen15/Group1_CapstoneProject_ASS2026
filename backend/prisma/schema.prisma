generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model alumni {
  AlumniID                 Int                     @id @default(autoincrement()) @db.UnsignedInt
  UserID                   Int                     @unique(map: "uq_alumni_user") @db.UnsignedInt
  ProgrammeID              Int                     @db.UnsignedSmallInt
  GraduationYear           Int                     @db.UnsignedSmallInt
  ProfessionalBackground   String?                 @db.Text
  AreaOfExpertise          String?                 @db.VarChar(255)
  CurrentDesignation       String?                 @db.VarChar(100)
  Location                 String?                 @db.VarChar(100)
  LinkedIn                 String?                 @db.VarChar(200)
  GitHub                   String?                 @db.VarChar(200)
  Website                  String?                 @db.VarChar(200)
  IsAvailableForMentorship Boolean                 @default(false)
  IsProfilePublic          Boolean                 @default(true)
  programme                programme               @relation(fields: [ProgrammeID], references: [ProgrammeID], onDelete: NoAction, onUpdate: NoAction, map: "fk_alumni_programme")
  user                     user                    @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction, map: "fk_alumni_user")
  career_history           career_history[]
  collaboration_request    collaboration_request[]
  contribution             contribution[]
  mentorship_request       mentorship_request[]
  project                  project[]
  publication              publication[]
  verification_request     verification_request[]

  @@index([ProgrammeID, GraduationYear], map: "idx_alumni_programme_year")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model application {
  ApplicationID     Int                           @id @default(autoincrement()) @db.UnsignedInt
  StudentID         String                        @db.VarChar(20)
  OpportunityID     Int                           @db.UnsignedInt
  SubmissionDate    DateTime                      @default(dbgenerated("(curdate())")) @db.Date
  ApplicationStatus application_ApplicationStatus @default(Submitted)
  opportunity       opportunity                   @relation(fields: [OpportunityID], references: [OpportunityID], onDelete: Cascade, onUpdate: NoAction, map: "fk_application_opportunity")
  student           student                       @relation(fields: [StudentID], references: [StudentID], onDelete: Cascade, onUpdate: NoAction, map: "fk_application_student")

  @@unique([StudentID, OpportunityID], map: "uq_application_student_opportunity")
  @@index([OpportunityID, ApplicationStatus], map: "idx_application_opportunity_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model career_history {
  CareerID     Int       @id @default(autoincrement()) @db.UnsignedInt
  AlumniID     Int       @db.UnsignedInt
  Organization String    @db.VarChar(150)
  Position     String    @db.VarChar(100)
  StartDate    DateTime  @db.Date
  EndDate      DateTime? @db.Date
  alumni       alumni    @relation(fields: [AlumniID], references: [AlumniID], onDelete: Cascade, onUpdate: NoAction, map: "fk_career_alumni")

  @@index([AlumniID, StartDate], map: "idx_career_alumni")
}

model contribution {
  ContributionID   Int                    @id @default(autoincrement()) @db.UnsignedInt
  AlumniID         Int?                   @db.UnsignedInt
  DonorName        String                 @db.VarChar(150)
  DonorType        contribution_DonorType @default(Alumni)
  DonorEmail       String?                @db.VarChar(150)
  Batch            String?                @db.VarChar(20)
  CategoryType     String                 @db.VarChar(60)
  Description      String?                @db.Text
  Value            Decimal?               @db.Decimal(12, 2)
  ContributionDate DateTime               @db.Date
  Status           contribution_Status    @default(Pending)
  RejectionReason  String?                @db.VarChar(500)
  Note             String?                @db.VarChar(500)
  InitiativeID     Int?                   @db.UnsignedInt
  VerifiedBy       Int?                   @db.UnsignedInt
  VerifiedAt       DateTime?              @db.DateTime(0)
  alumni           alumni?                @relation(fields: [AlumniID], references: [AlumniID], onDelete: NoAction, onUpdate: NoAction, map: "fk_contribution_alumni")
  initiative       initiative?            @relation(fields: [InitiativeID], references: [InitiativeID], onDelete: NoAction, onUpdate: NoAction, map: "fk_contribution_initiative")
  user             user?                  @relation(fields: [VerifiedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "fk_contribution_verifier")

  @@index([AlumniID], map: "fk_contribution_alumni")
  @@index([InitiativeID], map: "fk_contribution_initiative")
  @@index([VerifiedBy], map: "fk_contribution_verifier")
  @@index([Status, ContributionDate], map: "idx_contribution_status")
}

model department {
  DepartmentID   Int                       @id @default(autoincrement()) @db.UnsignedSmallInt
  DepartmentName String                    @unique(map: "uq_department_name") @db.VarChar(100)
  DepartmentType department_DepartmentType @default(Academic)
  programme      programme[]
  staff          staff[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model event {
  EventID              Int                  @id @default(autoincrement()) @db.UnsignedInt
  CreatorID            Int                  @db.UnsignedInt
  Title                String               @db.VarChar(150)
  Description          String?              @db.Text
  EventDate            DateTime             @db.DateTime(0)
  Duration             String?              @db.VarChar(50)
  Venue                String?              @db.VarChar(150)
  Organizer            String?              @db.VarChar(150)
  ExpectedParticipants Int?                 @db.UnsignedInt
  Categories           Json?
  Status               event_Status         @default(Published)
  ApprovalStatus       event_ApprovalStatus @default(Approved)
  CreatedAt            DateTime             @default(now()) @db.Timestamp(0)
  user                 user                 @relation(fields: [CreatorID], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "fk_event_creator")
  event_registration   event_registration[]

  @@index([CreatorID], map: "fk_event_creator")
  @@index([EventDate], map: "idx_event_date")
  @@index([Status, ApprovalStatus], map: "idx_event_status")
}

model event_registration {
  RegistrationID   Int      @id @default(autoincrement()) @db.UnsignedInt
  UserID           Int      @db.UnsignedInt
  EventID          Int      @db.UnsignedInt
  RegistrationDate DateTime @default(now()) @db.Timestamp(0)
  event            event    @relation(fields: [EventID], references: [EventID], onDelete: Cascade, onUpdate: NoAction, map: "fk_eventreg_event")
  user             user     @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction, map: "fk_eventreg_user")

  @@unique([UserID, EventID], map: "uq_registration_user_event")
  @@index([EventID], map: "fk_registration_event")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model mentorship_request {
  RequestID      Int                       @id @default(autoincrement()) @db.UnsignedInt
  StudentID      String                    @db.VarChar(20)
  AlumniID       Int                       @db.UnsignedInt
  AreaOfInterest String?                   @db.VarChar(100)
  RequestSubject String                    @db.VarChar(150)
  RequestDetail  String?                   @db.Text
  Duration       String?                   @db.VarChar(50)
  RequestDate    DateTime                  @default(dbgenerated("(curdate())")) @db.Date
  Status         mentorship_request_Status @default(Pending)
  ResponseNote   String?                   @db.VarChar(500)
  RespondedAt    DateTime?                 @db.DateTime(0)
  alumni         alumni                    @relation(fields: [AlumniID], references: [AlumniID], onDelete: Cascade, onUpdate: NoAction, map: "fk_mentorship_alumni")
  student        student                   @relation(fields: [StudentID], references: [StudentID], onDelete: Cascade, onUpdate: NoAction, map: "fk_mentorship_student")

  @@index([AlumniID, Status], map: "idx_mentorship_alumni_status")
  @@index([StudentID], map: "idx_mentorship_student")
}

model notification {
  NotificationID   Int      @id @default(autoincrement()) @db.UnsignedInt
  UserID           Int      @db.UnsignedInt
  NotificationType String   @db.VarChar(40)
  Title            String?  @db.VarChar(150)
  Message          String   @db.VarChar(500)
  Link             String?  @db.VarChar(200)
  CreatedAt        DateTime @default(now()) @db.Timestamp(0)
  IsRead           Boolean  @default(false)
  user             user     @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction, map: "fk_notification_user")

  @@index([UserID, IsRead, CreatedAt], map: "idx_notification_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model opportunity {
  OpportunityID           Int                   @id @default(autoincrement()) @db.UnsignedInt
  CreatorID               Int                   @db.UnsignedInt
  Title                   String                @db.VarChar(150)
  OpportunityType         String                @default("Internship") @db.VarChar(30)
  Organization            String                @db.VarChar(150)
  Location                String?               @db.VarChar(100)
  WorkType                opportunity_WorkType?
  Category                String?               @db.VarChar(60)
  Description             String?               @db.Text
  Deadline                DateTime?             @db.Date
  StartDate               DateTime?             @db.Date
  Duration                String?               @db.VarChar(50)
  EligibilityRequirements String?               @db.Text
  Status                  opportunity_Status    @default(Pending)
  RejectionReason         String?               @db.VarChar(500)
  PostedAt                DateTime              @default(now()) @db.Timestamp(0)
  application             application[]
  user                    user                  @relation(fields: [CreatorID], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "fk_opportunity_creator")
  saved_opportunity       saved_opportunity[]

  @@index([CreatorID], map: "idx_opportunity_creator")
  @@index([Status, Deadline], map: "idx_opportunity_status_deadline")
}

model programme {
  ProgrammeID   Int        @id @default(autoincrement()) @db.UnsignedSmallInt
  DepartmentID  Int        @db.UnsignedSmallInt
  ProgrammeName String     @unique(map: "uq_programme_name") @db.VarChar(120)
  alumni        alumni[]
  department    department @relation(fields: [DepartmentID], references: [DepartmentID], onDelete: NoAction, onUpdate: NoAction, map: "fk_programme_department")
  student       student[]

  @@index([DepartmentID], map: "fk_programme_department")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model project {
  ProjectID     Int       @id @default(autoincrement()) @db.UnsignedInt
  AlumniID      Int       @db.UnsignedInt
  Title         String    @db.VarChar(255)
  Description   String?   @db.Text
  StartDate     DateTime? @db.Date
  EndDate       DateTime? @db.Date
  FundingAgency String?   @db.VarChar(150)
  alumni        alumni    @relation(fields: [AlumniID], references: [AlumniID], onDelete: Cascade, onUpdate: NoAction, map: "fk_project_alumni")

  @@index([AlumniID], map: "idx_project_alumni")
}

model publication {
  PublicationID   Int       @id @default(autoincrement()) @db.UnsignedInt
  AlumniID        Int       @db.UnsignedInt
  Title           String    @db.VarChar(255)
  PublicationType String    @db.VarChar(50)
  PublicationDate DateTime? @db.Date
  alumni          alumni    @relation(fields: [AlumniID], references: [AlumniID], onDelete: Cascade, onUpdate: NoAction, map: "fk_publication_alumni")

  @@index([AlumniID], map: "idx_publication_alumni")
}

model role {
  RoleID   Int    @id @default(autoincrement()) @db.UnsignedTinyInt
  RoleName String @unique(map: "uq_role_name") @db.VarChar(20)
  user     user[]
}

model staff {
  StaffID         String      @id @db.VarChar(20)
  UserID          Int         @unique(map: "uq_staff_user") @db.UnsignedInt
  DepartmentID    Int?        @db.UnsignedSmallInt
  Qualifications  String?     @db.VarChar(255)
  Designation     String?     @db.VarChar(100)
  AreaOfExpertise String?     @db.VarChar(255)
  department      department? @relation(fields: [DepartmentID], references: [DepartmentID], onDelete: NoAction, onUpdate: NoAction, map: "fk_staff_department")
  user            user        @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction, map: "fk_staff_user")

  @@index([DepartmentID], map: "fk_staff_department")
}

model student {
  StudentID          String               @id @db.VarChar(20)
  UserID             Int                  @unique(map: "uq_student_user") @db.UnsignedInt
  ProgrammeID        Int                  @db.UnsignedSmallInt
  YearOfJoining      Int                  @db.UnsignedSmallInt
  Dzongkhag          String?              @db.VarChar(50)
  Gewog              String?              @db.VarChar(50)
  Projects           Json?
  TechnicalSkills    Json?
  SoftSkills         Json?
  Photo              String?              @db.VarChar(255)
  About              String?              @db.Text
  Location           String?              @db.VarChar(100)
  Interests          Json?
  Languages          Json?
  Motto              String?              @db.VarChar(200)
  GitHub             String?              @db.VarChar(200)
  LinkedIn           String?              @db.VarChar(200)
  Website            String?              @db.VarChar(200)
  ShowEmail          Boolean              @default(true)
  ShowPhone          Boolean              @default(false)
  application        application[]
  mentorship_request mentorship_request[]
  saved_opportunity  saved_opportunity[]
  programme          programme            @relation(fields: [ProgrammeID], references: [ProgrammeID], onDelete: NoAction, onUpdate: NoAction, map: "fk_student_programme")
  user               user                 @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction, map: "fk_student_user")

  @@index([ProgrammeID], map: "idx_student_programme")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user {
  UserID                 Int                      @id @default(autoincrement()) @db.UnsignedInt
  RoleID                 Int                      @db.UnsignedTinyInt
  Username               String                   @unique(map: "uq_user_username") @db.VarChar(100)
  PasswordHash           String                   @db.VarChar(255)
  Name                   String                   @db.VarChar(100)
  Email                  String                   @unique(map: "uq_user_email") @db.VarChar(150)
  PhoneNo                String?                  @db.VarChar(20)
  AccountStatus          user_AccountStatus       @default(Pending)
  CreatedAt              DateTime                 @default(now()) @db.Timestamp(0)
  LastLoginAt            DateTime?                @db.Timestamp(0)
  alumni                 alumni?
  announcement           announcement[]
  collaboration_request  collaboration_request[]
  contribution           contribution[]
  event                  event[]
  event_registration     event_registration[]
  initiative             initiative[]
  initiative_participant initiative_participant[]
  notification           notification[]
  opportunity            opportunity[]
  password_reset         password_reset[]
  staff                  staff?
  student                student?
  role                   role                     @relation(fields: [RoleID], references: [RoleID], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_role")
  user_settings          user_settings?
  verification_request   verification_request[]

  @@index([RoleID, AccountStatus], map: "idx_user_role_status")
}

model announcement {
  AnnouncementID Int                   @id @default(autoincrement()) @db.UnsignedInt
  CreatedBy      Int                   @db.UnsignedInt
  Title          String                @db.VarChar(150)
  Message        String                @db.Text
  Audience       announcement_Audience @default(Everyone)
  CreatedAt      DateTime              @default(now()) @db.Timestamp(0)
  user           user                  @relation(fields: [CreatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "fk_announcement_creator")

  @@index([CreatedBy], map: "fk_announcement_creator")
  @@index([CreatedAt], map: "idx_announcement_created")
}

model collaboration_request {
  CollaborationID   Int                          @id @default(autoincrement()) @db.UnsignedInt
  AlumniID          Int                          @db.UnsignedInt
  Title             String                       @db.VarChar(150)
  CollaborationType String?                      @db.VarChar(60)
  Description       String?                      @db.Text
  ProposedDate      DateTime?                    @db.Date
  Status            collaboration_request_Status @default(Pending)
  ResponseNote      String?                      @db.VarChar(500)
  ReviewedBy        Int?                         @db.UnsignedInt
  CreatedAt         DateTime                     @default(now()) @db.Timestamp(0)
  alumni            alumni                       @relation(fields: [AlumniID], references: [AlumniID], onDelete: Cascade, onUpdate: NoAction, map: "fk_collab_alumni")
  user              user?                        @relation(fields: [ReviewedBy], references: [UserID], onUpdate: NoAction, map: "fk_collab_reviewer")

  @@index([AlumniID], map: "fk_collab_alumni")
  @@index([ReviewedBy], map: "fk_collab_reviewer")
}

model initiative {
  InitiativeID           Int                      @id @default(autoincrement()) @db.UnsignedInt
  Title                  String                   @db.VarChar(150)
  Description            String?                  @db.Text
  Goal                   String?                  @db.VarChar(255)
  Icon                   String?                  @db.VarChar(50)
  StartDate              DateTime?                @db.Date
  EndDate                DateTime?                @db.Date
  IsActive               Boolean                  @default(true)
  CreatedBy              Int?                     @db.UnsignedInt
  CreatedAt              DateTime                 @default(now()) @db.Timestamp(0)
  contribution           contribution[]
  user                   user?                    @relation(fields: [CreatedBy], references: [UserID], onUpdate: NoAction, map: "fk_initiative_creator")
  initiative_participant initiative_participant[]

  @@index([CreatedBy], map: "fk_initiative_creator")
}

model initiative_participant {
  UserID       Int        @db.UnsignedInt
  InitiativeID Int        @db.UnsignedInt
  JoinedAt     DateTime   @default(now()) @db.Timestamp(0)
  initiative   initiative @relation(fields: [InitiativeID], references: [InitiativeID], onDelete: Cascade, onUpdate: NoAction, map: "fk_ip_initiative")
  user         user       @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction, map: "fk_ip_user")

  @@id([UserID, InitiativeID])
  @@index([InitiativeID], map: "fk_ip_initiative")
}

model password_reset {
  ResetID   Int       @id @default(autoincrement()) @db.UnsignedInt
  UserID    Int       @db.UnsignedInt
  TokenHash String    @unique(map: "uq_reset_token") @db.Char(64)
  ExpiresAt DateTime  @db.DateTime(0)
  UsedAt    DateTime? @db.DateTime(0)
  CreatedAt DateTime  @default(now()) @db.Timestamp(0)
  user      user      @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction, map: "fk_reset_user")

  @@index([UserID], map: "fk_reset_user")
}

model saved_opportunity {
  StudentID     String      @db.VarChar(20)
  OpportunityID Int         @db.UnsignedInt
  SavedAt       DateTime    @default(now()) @db.Timestamp(0)
  opportunity   opportunity @relation(fields: [OpportunityID], references: [OpportunityID], onDelete: Cascade, onUpdate: NoAction, map: "fk_saved_opportunity")
  student       student     @relation(fields: [StudentID], references: [StudentID], onDelete: Cascade, onUpdate: NoAction, map: "fk_saved_student")

  @@id([StudentID, OpportunityID])
  @@index([OpportunityID], map: "fk_saved_opportunity")
}

model user_settings {
  UserID    Int      @id @db.UnsignedInt
  Settings  Json
  UpdatedAt DateTime @default(now()) @db.Timestamp(0)
  user      user     @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction, map: "fk_settings_user")
}

model verification_request {
  VerificationID    Int                         @id @default(autoincrement()) @db.UnsignedInt
  AlumniID          Int                         @db.UnsignedInt
  ProofDocumentPath String                      @db.VarChar(255)
  SubmittedAt       DateTime                    @default(now()) @db.DateTime(0)
  Status            verification_request_Status @default(Pending)
  RejectionReason   String?                     @db.VarChar(500)
  ReviewedBy        Int?                        @db.UnsignedInt
  ReviewedAt        DateTime?                   @db.DateTime(0)
  alumni            alumni                      @relation(fields: [AlumniID], references: [AlumniID], onDelete: Cascade, onUpdate: NoAction, map: "fk_verification_alumni")
  user              user?                       @relation(fields: [ReviewedBy], references: [UserID], onUpdate: NoAction, map: "fk_verification_reviewer")

  @@index([AlumniID], map: "fk_verification_alumni")
  @@index([ReviewedBy], map: "fk_verification_reviewer")
  @@index([Status, SubmittedAt], map: "idx_verification_status")
}

enum department_DepartmentType {
  Academic
  Administrative
}

enum contribution_DonorType {
  Alumni
  Organization
  Anonymous
}

enum announcement_Audience {
  Everyone
  Students
  Alumni
  Staff
}

enum application_ApplicationStatus {
  Submitted
  UnderReview
  Shortlisted
  Accepted
  Rejected
  Withdrawn
}

enum verification_request_Status {
  Pending
  Approved
  Rejected
}

enum collaboration_request_Status {
  Pending
  Accepted
  Declined
}

enum opportunity_WorkType {
  On_site @map("On-site")
  Remote
  Hybrid
}

enum user_AccountStatus {
  Pending
  Active
  Suspended
}

enum mentorship_request_Status {
  Pending
  Accepted
  Declined
  Cancelled
}

enum contribution_Status {
  Pending
  Verified
  Rejected
}

enum event_Status {
  Published
  Cancelled
  Completed
}

enum event_ApprovalStatus {
  Pending
  Approved
  Rejected
}

enum opportunity_Status {
  Draft
  Pending
  Approved
  Rejected
  Closed
  Cancelled
}
